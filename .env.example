# MetricSleuth Environment Configuration Template
OPENAI_API_KEY=<local-only-secret>

# Use "responses" for Providers exposing /v1/responses; set "chat_completions"
# for OpenAI-compatible Providers that only expose /v1/chat/completions.
OPENAI_API_MODE=responses

# Local OpenAI-compatible gateways normally do not implement OpenAI tracing export.
OPENAI_AGENTS_DISABLE_TRACING=0

# Official default example. Compatible endpoints must be configured explicitly
# and should only be used after the operator has reviewed and trusted them.
OPENAI_BASE_URL=https://api.openai.com/v1

# Keep live benchmark runs reproducible by explicitly recording the actual model
# through this environment variable or the validation script's CLI option.
METRICSLEUTH_AGENT_MODEL=gpt-4o-mini

# Local warehouse example (replace the password locally; never commit it).
# DATABASE_URL=postgresql://metricsleuth:<local-db-password>@127.0.0.1:5432/metricsleuth

# Never commit .env. Revoke and rotate any key exposed in chat or logs.
